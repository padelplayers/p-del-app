rules_version = '2';

// Reglas compatibles con la arquitectura cliente actual.
// Los permisos temporales amplios estan documentados en
// AUDITORIA_COMPATIBILIDAD_REGLAS_DEFINITIVAS.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function currentUserExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasCompleteProfile() {
      return currentUserExists() &&
        currentUserData().get('perfilCompleto', false) == true;
    }

    function isAdmin() {
      return currentUserExists() && (
        currentUserData().get('admin', false) == true ||
        currentUserData().get('rol', '') == 'admin'
      );
    }

    function clientPrivilegesValidOnCreate() {
      return !request.resource.data.keys().hasAny(['rol']) &&
        request.resource.data.get('admin', false) == false;
    }

    function validClientEmailOnCreate() {
      return !request.resource.data.keys().hasAny(['email']) ||
        request.resource.data.get('email', '') == request.auth.token.email;
    }

    function emailUnchangedOrOwn() {
      return resource.data.keys().hasAny(['email'])
        ? request.resource.data.get('email', '') == resource.data.get('email', '')
        : (
            !request.resource.data.keys().hasAny(['email']) ||
            request.resource.data.get('email', '') == request.auth.token.email
          );
    }

    function validIncompleteUserCreate() {
      return request.resource.data.get('perfilCompleto', false) == false &&
        validClientEmailOnCreate() &&
        request.resource.data.keys().hasOnly([
          'perfilCompleto',
          'email',
          'terminosAceptados',
          'terminosAceptadosAt',
          'registroIniciadoAt',
          'eliminacionPendienteAuth',
          'eliminacionPendienteAt'
        ]);
    }

    function validCompleteUserCreate() {
      return request.resource.data.get('perfilCompleto', false) == true &&
        request.resource.data.get('nombre', '') is string &&
        request.resource.data.get('nombre', '').size() > 0 &&
        request.resource.data.get('sexo', '') is string &&
        request.resource.data.get('sexo', '').size() > 0 &&
        request.resource.data.get('nivel', '') is string &&
        request.resource.data.get('nivel', '').size() > 0 &&
        request.resource.data.get('mano', '') is string &&
        request.resource.data.get('mano', '').size() > 0 &&
        request.resource.data.get('posicion', '') is string &&
        request.resource.data.get('posicion', '').size() > 0;
    }

    function privilegesUnchanged() {
      return request.resource.data.get('admin', false) == resource.data.get('admin', false) &&
        request.resource.data.get('rol', '') == resource.data.get('rol', '');
    }

    function validPresenceState() {
      return request.resource.data.get('online', false) != true ||
        request.resource.data.get('perfilCompleto', false) == true;
    }

    function compatibleCrossUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'seguidores',
        'siguiendo',
        'seguidos',
        'clasificacion',
        'penalizaciones',
        'incidenciasPostPartido',
        'restriccionFiabilidad',
        'restriccionNoPresentado',
        'nivel',
        'nivelInicial',
        'nivelDelta',
        'rankingPartidos'
      ]);
    }

    function oldIncompleteUserForCleanup() {
      return resource.data.get('perfilCompleto', true) == false &&
        resource.data.get('registroIniciadoAt', null) is timestamp &&
        resource.data.get('registroIniciadoAt', request.time) <= request.time - duration.value(72, 'h');
    }

    function partidaData(partidaId) {
      return get(/databases/$(database)/documents/partidas/$(partidaId)).data;
    }

    function isPartidaParticipant(partidaId) {
      return signedIn() && (
        request.auth.uid in partidaData(partidaId).get('jugadores', []) ||
        request.auth.uid in partidaData(partidaId).get('reservas', [])
      );
    }

    function privateChatData(chatId) {
      return get(/databases/$(database)/documents/chatsPrivados/$(chatId)).data;
    }

    function isPrivateParticipant(data) {
      return signedIn() && (
        request.auth.uid in data.get('participantes', []) ||
        data.get('participantesMap', {}).get(request.auth.uid, false) == true
      );
    }

    function validPrivateParticipants(data) {
      return data.get('participantes', []) is list &&
        data.get('participantes', []).size() == 2 &&
        data.get('participantes', [])[0] != data.get('participantes', [])[1] &&
        data.get('participantesMap', {}) is map &&
        data.get('participantesMap', {}).size() == 2 &&
        request.auth.uid in data.get('participantes', []) &&
        data.get('participantesMap', {}).get(data.get('participantes', [])[0], false) == true &&
        data.get('participantesMap', {}).get(data.get('participantes', [])[1], false) == true;
    }

    function validUserMessage() {
      return request.resource.data.get('u', '') == request.auth.uid &&
        request.resource.data.get('type', '') == 'text' &&
        request.resource.data.get('t', '') is string;
    }

    function validSystemMessage() {
      return request.resource.data.get('u', '') == 'sistema' &&
        request.resource.data.get('type', '') == 'system' &&
        request.resource.data.get('system', false) == true &&
        request.resource.data.get('t', '') is string;
    }

    function validGeneralChatCreate() {
      return request.resource.data.keys().hasOnly([
        'lastMessage',
        'lastActivity',
        'lastSender',
        'lastSenderName',
        'lastMessageType'
      ]);
    }

    function validGeneralChatUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessage',
        'lastActivity',
        'lastSender',
        'lastSenderName',
        'lastMessageType'
      ]);
    }

    function validPrivateChatFields() {
      return request.resource.data.keys().hasOnly([
        'participantes',
        'participantesMap',
        'actualizadoAt',
        'lastMessage',
        'lastActivity',
        'lastSender',
        'lastSenderName',
        'lastMessageType'
      ]);
    }

    function validPrivateChatUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'participantes',
        'participantesMap',
        'actualizadoAt',
        'lastMessage',
        'lastActivity',
        'lastSender',
        'lastSenderName',
        'lastMessageType'
      ]);
    }

    match /usuarios/{uid} {
      // Jugadores, clasificacion, presencia y estadisticas necesitan listar perfiles.
      allow read: if signedIn();

      allow create: if isOwner(uid) &&
        clientPrivilegesValidOnCreate() &&
        validClientEmailOnCreate() &&
        (validIncompleteUserCreate() || validCompleteUserCreate());

      // Excepcion temporal: postpartido, ranking, seguimiento y borrado de perfil
      // actualizan campos concretos de otros usuarios desde el cliente.
      allow update: if signedIn() && privilegesUnchanged() && (
        (
          isOwner(uid) &&
          emailUnchangedOrOwn() &&
          validPresenceState()
        ) ||
        compatibleCrossUserUpdate()
      );

      allow delete: if isOwner(uid) || (isAdmin() && oldIncompleteUserForCleanup());

      match /chatLeidos/{chatId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /estadisticas_globales/{documento} {
      allow read: if signedIn() && documento == 'resumen';
      allow create, update: if documento == 'resumen' && isAdmin();
      allow delete: if false;
    }

    match /limpieza_auth_pendiente/{documento} {
      allow read, write: if isAdmin();
    }

    match /pistas/{pistaId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.get('creadaPor', '') == request.auth.uid &&
        request.resource.data.get('imagen', '') is string &&
        request.resource.data.get('imagen', '').size() > 0 &&
        (request.resource.data.get('verificada', false) == false || isAdmin());

      // El propietario puede editar su pista privada sin alterar propiedad,
      // verificacion ni privilegios. La segunda rama conserva la anonimizacion.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.get('tipo', '') == 'privada' &&
        resource.data.get('creadaPor', '') == request.auth.uid &&
        request.resource.data.get('tipo', '') == 'privada' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creadaPor', 'creador', 'creadorUid', 'creadaPorUid',
          'verificada', 'verificadaPor', 'fechaVerificada', 'admin', 'rol'
        ])
      ) || (
        signedIn() &&
        (
          resource.data.get('creadaPor', '') == request.auth.uid ||
          resource.data.get('creador', '') == request.auth.uid ||
          resource.data.get('creadorUid', '') == request.auth.uid ||
          resource.data.get('creadaPorUid', '') == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'creadaPor', 'creador', 'creadorUid', 'creadaPorUid',
          'creadorNombre', 'nombreCreador'
        ])
      );

      allow delete: if isAdmin() || (
        signedIn() &&
        resource.data.get('tipo', '') == 'privada' &&
        resource.data.get('creadaPor', '') == request.auth.uid
      );
    }

    match /partidas/{partidaId} {
      allow read: if signedIn();

      allow create: if hasCompleteProfile() &&
        request.resource.data.get('creadaPor', '') == request.auth.uid &&
        request.resource.data.get('creador', '') == request.auth.uid &&
        request.resource.data.get('jugadores', []) == [request.auth.uid] &&
        request.resource.data.get('reservas', []).size() == 0 &&
        request.resource.data.get('estado', '') == 'abierta';

      // Temporalmente amplio: unirse, salir, sustituciones, confirmacion,
      // postpartido y limpieza automatica siguen ejecutandose en cliente.
      allow update, delete: if signedIn();

      match /mensajes/{mensajeId} {
        allow read: if isPartidaParticipant(partidaId) ||
          (signedIn() && resource.data.get('u', '') == request.auth.uid);
        allow create: if isPartidaParticipant(partidaId) && validUserMessage();
        allow delete: if isPartidaParticipant(partidaId) ||
          (signedIn() && resource.data.get('u', '') == request.auth.uid);
        allow update: if false;
      }
    }

    match /chats/general {
      allow read: if hasCompleteProfile();
      allow create: if hasCompleteProfile() && validGeneralChatCreate();
      allow update: if hasCompleteProfile() && validGeneralChatUpdate();
      allow delete: if isAdmin();

      match /mensajes/{mensajeId} {
        allow read: if hasCompleteProfile();
        allow create: if hasCompleteProfile() &&
          (validUserMessage() || validSystemMessage());

        allow update: if hasCompleteProfile() &&
          (
            resource.data.get('system', false) == true ||
            resource.data.get('type', '') == 'system'
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            't', 'eventType', 'action', 'valid'
          ]);

        // TEMPORAL: retencion y eliminacion de perfil borran mensajes ajenos.
        allow delete: if hasCompleteProfile();
      }
    }

    match /chatsPrivados/{chatId} {
      allow read: if isPrivateParticipant(resource.data);

      allow create: if hasCompleteProfile() &&
        validPrivateParticipants(request.resource.data) &&
        validPrivateChatFields();

      allow update: if isPrivateParticipant(resource.data) &&
        validPrivateParticipants(request.resource.data) &&
        validPrivateChatUpdate() &&
        (
          request.resource.data.participantes == resource.data.get('participantes', []) ||
          resource.data.get('participantes', []).size() == 0
        );

      // Eliminar perfil borra las conversaciones en las que participa.
      allow delete: if isPrivateParticipant(resource.data);

      match /mensajes/{mensajeId} {
        allow read: if isPrivateParticipant(privateChatData(chatId));
        allow create: if isPrivateParticipant(privateChatData(chatId)) &&
          validUserMessage();
        allow delete: if isPrivateParticipant(privateChatData(chatId));
        allow update: if false;
      }
    }

    match /historial_partidas/{partidaId} {
      // TEMPORAL: estadisticas admin, cierre y anonimizacion viven en cliente.
      allow read, create, update, delete: if signedIn();
    }

    match /notificaciones/{notificacionId} {
      // TEMPORAL: avisos a terceros, agrupacion y limpieza viven en cliente.
      allow read, update, delete: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.get('uid', '') is string &&
        request.resource.data.get('uid', '').size() > 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
