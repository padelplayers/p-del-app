rules_version = '2';

// Reglas compatibles con rutas actuales. pistas/{timestamp}.jpg no contiene
// UID y no permite demostrar quien creo el objeto.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('admin', false) == true ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') == 'admin'
      );
    }

    function validProfileImage() {
      return request.resource != null &&
        request.resource.size <= 450 * 1024 &&
        request.resource.contentType == 'image/jpeg';
    }

    function validCourtImage() {
      return request.resource != null &&
        request.resource.size <= 900 * 1024 &&
        request.resource.contentType == 'image/jpeg';
    }

    match /usuarios/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        fileName.matches('foto_[A-Za-z0-9._-]+[.]jpg') &&
        validProfileImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /fotosPerfil/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        validProfileImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /fotosPerfil/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() &&
        (fileName == request.auth.uid || fileName.matches(request.auth.uid + '[.].+')) &&
        validProfileImage();
      allow delete: if signedIn() &&
        (fileName == request.auth.uid || fileName.matches(request.auth.uid + '[.].+'));
    }

    // La ruta actual no incluye UID. Se permite crear a un autenticado, pero
    // solo admin puede sobrescribir o borrar. Migrar a pistas/{uid}/{archivo}.
    match /pistas/{fileName} {
      allow read: if true;
      allow create: if signedIn() &&
        fileName.matches('[0-9]+[.]jpg') &&
        validCourtImage();
      allow update: if isAdmin() && validCourtImage();
      allow delete: if isAdmin();
    }

    match /imagenesPistas/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validCourtImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
