[debug] [2026-06-28T14:11:02.285Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/padel-app-9e144/rulesets {"name":"projects/padel-app-9e144/rulesets/856e8f30-3e50-4533-9038-ff7d4e7c1965","source":{"files":[{"content":"rules_version = '2';\n\n// Reglas compatibles con la arquitectura cliente actual.\n// Los permisos temporales amplios estan documentados en\n// AUDITORIA_COMPATIBILIDAD_REGLAS_DEFINITIVAS.md.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function currentUserData() {\n      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;\n    }\n\n    function currentUserExists() {\n      return signedIn() &&\n        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));\n    }\n\n    function hasCompleteProfile() {\n      return currentUserExists() &&\n        currentUserData().get('perfilCompleto', false) == true;\n    }\n\n    function isAdmin() {\n      return currentUserExists() && (\n        currentUserData().get('admin', false) == true ||\n        currentUserData().get('rol', '') == 'admin'\n      );\n    }\n\n    function clientPrivilegesValidOnCreate() {\n      return !request.resource.data.keys().hasAny(['rol']) &&\n        request.resource.data.get('admin', false) == false;\n    }\n\n    function validClientEmailOnCreate() {\n      return !request.resource.data.keys().hasAny(['email']) ||\n        request.resource.data.get('email', '') == request.auth.token.email;\n    }\n\n    function emailUnchangedOrOwn() {\n      return resource.data.keys().hasAny(['email'])\n        ? request.resource.data.get('email', '') == resource.data.get('email', '')\n        : (\n            !request.resource.data.keys().hasAny(['email']) ||\n            request.resource.data.get('email', '') == request.auth.token.email\n          );\n    }\n\n    function validIncompleteUserCreate() {\n      return request.resource.data.get('perfilCompleto', false) == false &&\n        validClientEmailOnCreate() &&\n        request.resource.data.keys().hasOnly([\n          'perfilCompleto',\n          'email',\n          'terminosAceptados',\n          'terminosAceptadosAt',\n          'registroIniciadoAt',\n          'eliminacionPendienteAuth',\n          'eliminacionPendienteAt'\n        ]);\n    }\n\n    function validCompleteUserCreate() {\n      return request.resource.data.get('perfilCompleto', false) == true &&\n        request.resource.data.get('nombre', '') is string &&\n        request.resource.data.get('nombre', '').size() > 0 &&\n        request.resource.data.get('sexo', '') is string &&\n        request.resource.data.get('sexo', '').size() > 0 &&\n        request.resource.data.get('nivel', '') is string &&\n        request.resource.data.get('nivel', '').size() > 0 &&\n        request.resource.data.get('mano', '') is string &&\n        request.resource.data.get('mano', '').size() > 0 &&\n        request.resource.data.get('posicion', '') is string &&\n        request.resource.data.get('posicion', '').size() > 0;\n    }\n\n    function privilegesUnchanged() {\n      return request.resource.data.get('admin', false) == resource.data.get('admin', false) &&\n        request.resource.data.get('rol', '') == resource.data.get('rol', '');\n    }\n\n    function validPresenceState() {\n      return request.resource.data.get('online', false) != true ||\n        request.resource.data.get('perfilCompleto', false) == true;\n    }\n\n    function compatibleCrossUserUpdate() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'seguidores',\n        'siguiendo',\n        'seguidos',\n        'clasificacion',\n        'penalizaciones',\n        'incidenciasPostPartido',\n        'restriccionFiabilidad',\n        'restriccionNoPresentado',\n        'nivel',\n        'nivelInicial',\n        'nivelDelta',\n        'rankingPartidos'\n      ]);\n    }\n\n    function oldIncompleteUserForCleanup() {\n      return resource.data.get('perfilCompleto', true) == false &&\n        resource.data.get('registroIniciadoAt', null) is timestamp &&\n        resource.data.get('registroIniciadoAt', request.time) <= request.time - duration.value(72, 'h');\n    }\n\n    function partidaData(partidaId) {\n      return get(/databases/$(database)/documents/partidas/$(partidaId)).data;\n    }\n\n    function isPartidaParticipant(partidaId) {\n      return signedIn() && (\n        request.auth.uid in partidaData(partidaId).get('jugadores', []) ||\n        request.auth.uid in partidaData(partidaId).get('reservas', [])\n      );\n    }\n\n    function privateChatData(chatId) {\n      return get(/databases/$(database)/documents/chatsPrivados/$(chatId)).data;\n    }\n\n    function isPrivateParticipant(data) {\n      return signedIn() && (\n        request.auth.uid in data.get('participantes', []) ||\n        data.get('participantesMap', {}).get(request.auth.uid, false) == true\n      );\n    }\n\n    function validPrivateParticipants(data) {\n      return data.get('participantes', []) is list &&\n        data.get('participantes', []).size() == 2 &&\n        data.get('participantes', [])[0] != data.get('participantes', [])[1] &&\n        data.get('participantesMap', {}) is map &&\n        data.get('participantesMap', {}).size() == 2 &&\n        request.auth.uid in data.get('participantes', []) &&\n        data.get('participantesMap', {}).get(data.get('participantes', [])[0], false) == true &&\n        data.get('participantesMap', {}).get(data.get('participantes', [])[1], false) == true;\n    }\n\n    function validUserMessage() {\n      return request.resource.data.get('u', '') == request.auth.uid &&\n        request.resource.data.get('type', '') == 'text' &&\n        request.resource.data.get('t', '') is string;\n    }\n\n    function validSystemMessage() {\n      return request.resource.data.get('u', '') == 'sistema' &&\n        request.resource.data.get('type', '') == 'system' &&\n        request.resource.data.get('system', false) == true &&\n        request.resource.data.get('t', '') is string;\n    }\n\n    function validGeneralChatCreate() {\n      return request.resource.data.keys().hasOnly([\n        'lastMessage',\n        'lastActivity',\n        'lastSender',\n        'lastSenderName',\n        'lastMessageType'\n      ]);\n    }\n\n    function validGeneralChatUpdate() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'lastMessage',\n        'lastActivity',\n        'lastSender',\n        'lastSenderName',\n        'lastMessageType'\n      ]);\n    }\n\n    function validPrivateChatFields() {\n      return request.resource.data.keys().hasOnly([\n        'participantes',\n        'participantesMap',\n        'actualizadoAt',\n        'lastMessage',\n        'lastActivity',\n        'lastSender',\n        'lastSenderName',\n        'lastMessageType'\n      ]);\n    }\n\n    function validPrivateChatUpdate() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'participantes',\n        'participantesMap',\n        'actualizadoAt',\n        'lastMessage',\n        'lastActivity',\n        'lastSender',\n        'lastSenderName',\n        'lastMessageType'\n      ]);\n    }\n\n    match /usuarios/{uid} {\n      // Jugadores, clasificacion, presencia y estadisticas necesitan listar perfiles.\n      allow read: if signedIn();\n\n      allow create: if isOwner(uid) &&\n        clientPrivilegesValidOnCreate() &&\n        validClientEmailOnCreate() &&\n        (validIncompleteUserCreate() || validCompleteUserCreate());\n\n      // Excepcion temporal: postpartido, ranking, seguimiento y borrado de perfil\n      // actualizan campos concretos de otros usuarios desde el cliente.\n      allow update: if signedIn() && privilegesUnchanged() && (\n        (\n          isOwner(uid) &&\n          emailUnchangedOrOwn() &&\n          validPresenceState()\n        ) ||\n        compatibleCrossUserUpdate()\n      );\n\n      allow delete: if isOwner(uid) || (isAdmin() && oldIncompleteUserForCleanup());\n\n      match /chatLeidos/{chatId} {\n        allow read, create, update, delete: if isOwner(uid);\n      }\n    }\n\n    match /estadisticas_globales/{documento} {\n      allow read: if signedIn() && documento == 'resumen';\n      allow create, update: if documento == 'resumen' && isAdmin();\n      allow delete: if false;\n    }\n\n    match /limpieza_auth_pendiente/{documento} {\n      allow read, write: if isAdmin();\n    }\n\n    match /pistas/{pistaId} {\n      allow read: if signedIn();\n\n      allow create: if signedIn() &&\n        request.resource.data.get('creadaPor', '') == request.auth.uid &&\n        request.resource.data.get('imagen', '') is string &&\n        request.resource.data.get('imagen', '').size() > 0 &&\n        (request.resource.data.get('verificada', false) == false || isAdmin());\n\n      // El propietario puede editar su pista privada sin alterar propiedad,\n      // verificacion ni privilegios. La segunda rama conserva la anonimizacion.\n      allow update: if isAdmin() || (\n        signedIn() &&\n        resource.data.get('tipo', '') == 'privada' &&\n        resource.data.get('creadaPor', '') == request.auth.uid &&\n        request.resource.data.get('tipo', '') == 'privada' &&\n        !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n          'creadaPor', 'creador', 'creadorUid', 'creadaPorUid',\n          'verificada', 'verificadaPor', 'fechaVerificada', 'admin', 'rol'\n        ])\n      ) || (\n        signedIn() &&\n        (\n          resource.data.get('creadaPor', '') == request.auth.uid ||\n          resource.data.get('creador', '') == request.auth.uid ||\n          resource.data.get('creadorUid', '') == request.auth.uid ||\n          resource.data.get('creadaPorUid', '') == request.auth.uid\n        ) &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'creadaPor', 'creador', 'creadorUid', 'creadaPorUid',\n          'creadorNombre', 'nombreCreador'\n        ])\n      );\n\n      allow delete: if isAdmin() || (\n        signedIn() &&\n        resource.data.get('tipo', '') == 'privada' &&\n        resource.data.get('creadaPor', '') == request.auth.uid\n      );\n    }\n\n    match /partidas/{partidaId} {\n      allow read: if signedIn();\n\n      allow create: if hasCompleteProfile() &&\n        request.resource.data.get('creadaPor', '') == request.auth.uid &&\n        request.resource.data.get('creador', '') == request.auth.uid &&\n        request.resource.data.get('jugadores', []) == [request.auth.uid] &&\n        request.resource.data.get('reservas', []).size() == 0 &&\n        request.resource.data.get('estado', '') == 'abierta';\n\n      // Temporalmente amplio: unirse, salir, sustituciones, confirmacion,\n      // postpartido y limpieza automatica siguen ejecutandose en cliente.\n      allow update, delete: if signedIn();\n\n      match /mensajes/{mensajeId} {\n        allow read: if isPartidaParticipant(partidaId) ||\n          (signedIn() && resource.data.get('u', '') == request.auth.uid);\n        allow create: if isPartidaParticipant(partidaId) && validUserMessage();\n        allow delete: if isPartidaParticipant(partidaId) ||\n          (signedIn() && resource.data.get('u', '') == request.auth.uid);\n        allow update: if false;\n      }\n    }\n\n    match /chats/general {\n      allow read: if hasCompleteProfile();\n      allow create: if hasCompleteProfile() && validGeneralChatCreate();\n      allow update: if hasCompleteProfile() && validGeneralChatUpdate();\n      allow delete: if isAdmin();\n\n      match /mensajes/{mensajeId} {\n        allow read: if hasCompleteProfile();\n        allow create: if hasCompleteProfile() &&\n          (validUserMessage() || validSystemMessage());\n\n        allow update: if hasCompleteProfile() &&\n          (\n            resource.data.get('system', false) == true ||\n            resource.data.get('type', '') == 'system'\n          ) &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            't', 'eventType', 'action', 'valid'\n          ]);\n\n        // TEMPORAL: retencion y eliminacion de perfil borran mensajes ajenos.\n        allow delete: if hasCompleteProfile();\n      }\n    }\n\n    match /chatsPrivados/{chatId} {\n      allow read: if isPrivateParticipant(resource.data);\n\n      allow create: if hasCompleteProfile() &&\n        validPrivateParticipants(request.resource.data) &&\n        validPrivateChatFields();\n\n      allow update: if isPrivateParticipant(resource.data) &&\n        validPrivateParticipants(request.resource.data) &&\n        validPrivateChatUpdate() &&\n        (\n          request.resource.data.participantes == resource.data.get('participantes', []) ||\n          resource.data.get('participantes', []).size() == 0\n        );\n\n      // Eliminar perfil borra las conversaciones en las que participa.\n      allow delete: if isPrivateParticipant(resource.data);\n\n      match /mensajes/{mensajeId} {\n        allow read: if isPrivateParticipant(privateChatData(chatId));\n        allow create: if isPrivateParticipant(privateChatData(chatId)) &&\n          validUserMessage();\n        allow delete: if isPrivateParticipant(privateChatData(chatId));\n        allow update: if false;\n      }\n    }\n\n    match /historial_partidas/{partidaId} {\n      // TEMPORAL: estadisticas admin, cierre y anonimizacion viven en cliente.\n      allow read, create, update, delete: if signedIn();\n    }\n\n    match /notificaciones/{notificacionId} {\n      // TEMPORAL: avisos a terceros, agrupacion y limpieza viven en cliente.\n      allow read, update, delete: if signedIn();\n      allow create: if signedIn() &&\n        request.resource.data.get('uid', '') is string &&\n        request.resource.data.get('uid', '').size() > 0;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-28T14:11:01.302863Z","metadata":{"services":["cloud.firestore"]}}
